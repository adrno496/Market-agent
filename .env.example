# AgentForge candidate. Empty values are intentional. Never commit a populated .env.
NODE_ENV=development
APP_NAME=AgentForge
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
ENABLE_LOCAL_WORKSHOP=true
LOG_REQUESTS=false

# Supabase: use a NEW dedicated project, not an existing AXDIA/site2 database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_LOCAL_SUPABASE=false
ARTIFACT_BUCKET=agentforge-artifacts
# Storage implementation in this release is private Supabase Storage, not S3.

# No model IDs are hardcoded. Choose IDs actually returned by the provider catalog.
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=
AI_INTERVIEW_PROVIDER=
AI_INTERVIEW_MODEL=
AI_ARCHITECT_PROVIDER=
AI_ARCHITECT_MODEL=
AI_CODE_PROVIDER=
AI_CODE_MODEL=
AI_REVIEW_PROVIDER=
AI_REVIEW_MODEL=
# INTERVIEW is used for optional AI extraction. CODE is used for code and repairs.
# ARCHITECT and REVIEW are reserved configuration slots, not separate executed phases yet.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Prices are USD per token, not USD per million. Direct APIs need verified overrides.
# Each override: provider, model_id, price_input, price_output, updated_at (ISO8601).
MODEL_CATALOG_OVERRIDES_JSON=[]
# Map explicitly selected provider names to real model IDs, e.g. {"openai":"<verified-id>"}.
AI_PROVIDER_DEFAULT_MODELS_JSON={}
CODE_MAX_OUTPUT_TOKENS=16000
BUDGET_STARTER_USD=2
BUDGET_PRODUCTION_USD=5
BUDGET_ADVANCED_USD=10
# Free AI interview: fixed conservative reservation <=0.05 USD/call, <=0.50 USD/user/UTC day.

GITHUB_TOKEN=
# Optional; public metadata can be queried without it subject to GitHub rate limits.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRODUCTION=
STRIPE_PRICE_ADVANCED=
ALLOW_LIVE_PAYMENTS=false
RELEASE_APPROVED=false
# Only enable real payments AFTER independent release review and successful real test-mode E2E.

# Long-running worker. Do not place the Docker socket in the web service.
WORKER_HOST=127.0.0.1
WORKER_PORT=3001
SANDBOX_PROVIDER=
SANDBOX_IMAGE=
ISOLATED_WORKER_ACK=false
# SANDBOX_IMAGE must be name@sha256:<verified actual digest>, with the labels in DEPLOYMENT.md.
# No unknown code runs on the host when Docker is absent: builds are blocked.
RECURSIVE_ROOT=
BR360_ROOT=
AXDIA_INTERNAL_USE_ACK=false
# Acknowledgement is an operational switch, NOT a legal license grant.

# Comma-separated Supabase auth user UUIDs. Never trust user-editable profile metadata.
ADMIN_USER_IDS=

# Optional diagnostics. These flags do not enable production behavior.
RUN_LIVE_CHECKS=false
# TSC_BIN and NODE_TYPES_DIR are optional for npm run typecheck.
