{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentforge:ProjectSpec:1.0.0",
  "title": "AgentForge ProjectSpec 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_name",
    "revision",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "description",
        "domain",
        "target_users",
        "workflows",
        "triggers",
        "inputs",
        "outputs",
        "channels",
        "integrations",
        "tools",
        "skills",
        "memory",
        "database",
        "authentication",
        "permissions",
        "autonomy",
        "approvals",
        "privacy",
        "sensitive_data",
        "expected_scale",
        "language",
        "runtime_language",
        "framework_preference",
        "provider_preference",
        "model_preference",
        "deployment_target",
        "observability",
        "success_criteria",
        "tests",
        "constraints",
        "calendar_provider",
        "working_hours",
        "services_durations",
        "timezone"
      ],
      "properties": {
        "objective": {
          "$ref": "#/$defs/fact"
        },
        "description": {
          "$ref": "#/$defs/fact"
        },
        "domain": {
          "$ref": "#/$defs/fact"
        },
        "target_users": {
          "$ref": "#/$defs/fact"
        },
        "workflows": {
          "$ref": "#/$defs/fact"
        },
        "triggers": {
          "$ref": "#/$defs/fact"
        },
        "inputs": {
          "$ref": "#/$defs/fact"
        },
        "outputs": {
          "$ref": "#/$defs/fact"
        },
        "channels": {
          "$ref": "#/$defs/fact"
        },
        "integrations": {
          "$ref": "#/$defs/fact"
        },
        "tools": {
          "$ref": "#/$defs/fact"
        },
        "skills": {
          "$ref": "#/$defs/fact"
        },
        "memory": {
          "$ref": "#/$defs/fact"
        },
        "database": {
          "$ref": "#/$defs/fact"
        },
        "authentication": {
          "$ref": "#/$defs/fact"
        },
        "permissions": {
          "$ref": "#/$defs/fact"
        },
        "autonomy": {
          "$ref": "#/$defs/fact"
        },
        "approvals": {
          "$ref": "#/$defs/fact"
        },
        "privacy": {
          "$ref": "#/$defs/fact"
        },
        "sensitive_data": {
          "$ref": "#/$defs/fact"
        },
        "expected_scale": {
          "$ref": "#/$defs/fact"
        },
        "language": {
          "$ref": "#/$defs/fact"
        },
        "runtime_language": {
          "$ref": "#/$defs/fact"
        },
        "framework_preference": {
          "$ref": "#/$defs/fact"
        },
        "provider_preference": {
          "$ref": "#/$defs/fact"
        },
        "model_preference": {
          "$ref": "#/$defs/fact"
        },
        "deployment_target": {
          "$ref": "#/$defs/fact"
        },
        "observability": {
          "$ref": "#/$defs/fact"
        },
        "success_criteria": {
          "$ref": "#/$defs/fact"
        },
        "tests": {
          "$ref": "#/$defs/fact"
        },
        "constraints": {
          "$ref": "#/$defs/fact"
        },
        "calendar_provider": {
          "$ref": "#/$defs/fact"
        },
        "working_hours": {
          "$ref": "#/$defs/fact"
        },
        "services_durations": {
          "$ref": "#/$defs/fact"
        },
        "timezone": {
          "$ref": "#/$defs/fact"
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "source",
        "confirmed",
        "updated_at"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "status": {
          "enum": [
            "FACT",
            "USER_CONFIRMED",
            "INFERRED",
            "UNKNOWN",
            "NEEDS_CONFIRMATION"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "maxLength": 250
        },
        "confirmed": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "USER_CONFIRMED"
              }
            }
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "confirmed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
