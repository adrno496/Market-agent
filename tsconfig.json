{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "types": ["node"], "verbatimModuleSyntax": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
